# Environment variables for C4 Code Review Assistant
# Copy this file to .env and insert your API keys.
# NEVER commit your actual .env file with real keys to version control!

# OpenAI API Key (for ChatGPT reviews)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude reviews)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (for Gemini reviews)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Model Provider (openai, claude, gemini)
DEFAULT_PROVIDER=gemini

# Optional: Enable Demo Mode by default when API keys are missing (true/false)
DEMO_MODE_FALLBACK=true
